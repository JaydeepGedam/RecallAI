# ==============================================================================
# RecallAI Environment Configuration
# ==============================================================================

# OpenAI API Configuration
# Required for memory extraction, classification, conflict detection, embeddings, and chat.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Database Configuration
# PostgreSQL with pgvector is the primary production/MVP database.
# For Docker setup: postgresql+psycopg2://postgres:postgres@db:5432/recallai
# For local Postgres: postgresql+psycopg2://postgres:postgres@localhost:5432/recallai
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/recallai

# JWT Authentication
JWT_SECRET=recallai_super_secret_jwt_key_change_in_production_123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Memory Ranking Weights (Must sum to 1.0)
WEIGHT_SEMANTIC=0.60
WEIGHT_IMPORTANCE=0.20
WEIGHT_CONFIDENCE=0.10
WEIGHT_RECENCY=0.10

# Recency Decay Settings
# Half-life in days: after this many days without access, recency score drops by 50%
RECENCY_HALF_LIFE_DAYS=30.0

# Duplicate and Conflict Detection Thresholds
DUPLICATE_SIMILARITY_THRESHOLD=0.88
CONFLICT_SIMILARITY_THRESHOLD=0.65

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
